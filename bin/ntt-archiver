#!/usr/bin/env bash
# Author: PB and Claude
# Date: 2025-10-09
# License: (c) HRDAG, 2025, GPL-2 or newer
#
# ------
# ntt/bin/ntt-archiver
#
# Archive disk images to cold storage after copying completes
#
# bash-logger: INTEGRATED (2025-11-02)

set -eo pipefail

# Check if running as root
if [[ $EUID -ne 0 ]]; then
   echo "Error: This script must be run with sudo or as root" >&2
   echo "Usage: sudo $0 <medium_hash> [--force] [--verbose]" >&2
   exit 1
fi

# ---------- source config ----------
# Source config from actual user's home (not root's ~)
if [[ -n "$SUDO_USER" ]]; then
  USER_HOME=$(eval echo ~$SUDO_USER)
  CONFIG_FILE="$USER_HOME/.config/ntt/ntt.env"
else
  CONFIG_FILE=~/.config/ntt/ntt.env
fi

if [[ -f "$CONFIG_FILE" ]]; then
  source "$CONFIG_FILE"
else
  # Fallback: use original user when running under sudo
  export PGUSER="${SUDO_USER:-$USER}"
fi

# ---------- config ----------
DB_URL="${NTT_DB_URL:-postgres:///copyjob}"
DB_USER="${PGUSER:-${SUDO_USER:-$USER}}"
IMAGE_ROOT="${NTT_IMAGE_ROOT:-/data/fast/img}"
ARCHIVE_ROOT="${NTT_IMAGES_ROOT:-/data/cold/img-read}"
LOG_FILE="${NTT_ARCHIVER_LOG:-/var/log/ntt/archiver.jsonl}"
mkdir -p "$(dirname "$LOG_FILE")"
chmod 755 "$(dirname "$LOG_FILE")" 2>/dev/null || true

# Source bash-logger
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"
source "$LIB_DIR/bash-logger.sh"

# Initialize logging (must be after LOG_FILE is set)
log_init || exit 1

# Wrapper for psql that handles running as root
psql_as_user() {
  if [[ $EUID -eq 0 ]] && [[ -n "$DB_USER" ]] && [[ "$DB_USER" != "root" ]]; then
    sudo -u "$DB_USER" psql "$@"
  else
    psql "$@"
  fi
}

# ---------- logging functions ----------
# NOTE: log_info/log_warn/log_error provided by bash-logger.sh

fail() {
  log_error "Error: $1"
  exit 1
}

# ---------- argparse ----------
usage() {
  cat <<EOF
Usage:
  sudo $0 <medium_hash> [--force] [--verbose] [--source <path>]

Archives disk images and extracted media to cold storage using dar.

Arguments:
  medium_hash    The medium hash to archive

Options:
  --force        Skip safety checks (copy completion, existing archive)
  --verbose      Show dar progress and detailed output
  --source       Override auto-detected source directory

Medium Types (auto-detected from database):
  physical       Disk image (.raw file)
                 Source: $IMAGE_ROOT/<hash>.raw
                 Destination: $ARCHIVE_ROOT/<hash>.1.dar

  extracted      Extracted tape/archive directory
                 Source: <image_path from database> or --source
                 Destination: $ARCHIVE_ROOT/<hash>.1.dar
                 Note: Excludes extracted/ subdirectory if present

  floppy         Floppy disk directory
                 Source: /data/fast/floppies/disks/<hash>/
                 Destination: $ARCHIVE_ROOT/floppies/<hash>.1.dar

  manual         Manual source (requires --source)
                 Source: <path from --source>
                 Destination: $ARCHIVE_ROOT/<hash>.1.dar

Features:
  - Creates dar archives with zstd:3 compression
  - Generates metadata.json from database (extracted/floppy types)
  - Instant catalogue listing without full decompression
  - Removes source after successful archival

Safety checks (unless --force):
  - All paths must be copied (physical/extracted types)
  - Archive must not already exist
  - Archive size > 0 after creation

Exit codes:
  0 = success
  1 = error
  2 = already archived (skipped)

Examples:
  # Physical disk image (auto-detected)
  sudo $0 af1349b9f5f9a1a6a0404dea36dcc949

  # Extracted tape with custom source
  sudo $0 b82431235963a5b1a8c5ab27dee5413a --source /data/fast/tapes/vxa/tape1

  # Force overwrite existing archive
  sudo $0 af1349b9f5f9a1a6a0404dea36dcc949 --force --verbose
EOF
  exit 1
}

# Parse arguments
[[ $# -ge 1 ]] || usage

MEDIUM_HASH=""
FORCE=false
VERBOSE=false
SOURCE_OVERRIDE=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --force)
      FORCE=true
      shift
      ;;
    --verbose)
      VERBOSE=true
      shift
      ;;
    --source)
      shift
      if [[ $# -ge 1 && "$1" != -* ]]; then
        SOURCE_OVERRIDE="$1"
        shift
      else
        echo "Error: --source requires a directory path" >&2
        usage
      fi
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      if [[ -z "$MEDIUM_HASH" ]]; then
        MEDIUM_HASH="$1"
        shift
      else
        echo "Error: Multiple medium hashes not supported" >&2
        usage
      fi
      ;;
  esac
done

[[ -n "$MEDIUM_HASH" ]] || usage

# Validate hash format (16-64 hex chars)
if [[ ! "$MEDIUM_HASH" =~ ^[a-f0-9]{16,64}$ ]]; then
  fail "Invalid medium_hash format (must be 16-64 hex chars)"
fi

# ---------- main ----------
log_info "Starting archive process for $MEDIUM_HASH (force=$FORCE verbose=$VERBOSE source=$SOURCE_OVERRIDE)"

# Query medium table for auto-detection (unless --source provided)
if [[ -z "$SOURCE_OVERRIDE" ]]; then
  MEDIUM_INFO=$(psql_as_user "$DB_URL" -tAc "
    SELECT medium_type, image_path
    FROM medium
    WHERE medium_hash = '$MEDIUM_HASH'
  " 2>/dev/null | grep -v "^Pager")

  if [[ -z "$MEDIUM_INFO" ]]; then
    log_warn "Medium not found in database, falling back to physical mode"
    MEDIUM_TYPE="physical"
    IMAGE_PATH=""
  else
    MEDIUM_TYPE=$(echo "$MEDIUM_INFO" | cut -d'|' -f1 | xargs)
    IMAGE_PATH=$(echo "$MEDIUM_INFO" | cut -d'|' -f2 | xargs)
    log_info "Detected medium_type=$MEDIUM_TYPE image_path=$IMAGE_PATH"
  fi
else
  # --source provided: check database for medium_type, fall back to manual
  MEDIUM_TYPE_DB=$(psql_as_user "$DB_URL" -tAc "
    SELECT medium_type
    FROM medium
    WHERE medium_hash = '$MEDIUM_HASH'
  " 2>/dev/null | grep -v "^Pager" | xargs)

  if [[ -n "$MEDIUM_TYPE_DB" ]]; then
    MEDIUM_TYPE="$MEDIUM_TYPE_DB"
    IMAGE_PATH="$SOURCE_OVERRIDE"
    log_info "Using medium_type=$MEDIUM_TYPE from database with --source override: $SOURCE_OVERRIDE"
  else
    MEDIUM_TYPE="manual"
    IMAGE_PATH="$SOURCE_OVERRIDE"
    log_info "Medium not in database, using manual mode with --source: $SOURCE_OVERRIDE"
  fi
fi

# Determine source directory based on medium type
case "$MEDIUM_TYPE" in
  physical)
    # Physical disk image - use image_path from database or fall back to search
    if [[ -n "$SOURCE_OVERRIDE" ]]; then
      SOURCE_DIR="$SOURCE_OVERRIDE"
      log_info "Using --source override for physical disk: $SOURCE_DIR"
    elif [[ -n "$IMAGE_PATH" ]]; then
      # Extract directory from full image path (e.g., /data/fast/img/hash.img -> /data/fast/img)
      SOURCE_DIR="$(dirname "$IMAGE_PATH")"
      if [[ ! -f "$IMAGE_PATH" ]]; then
        fail "Physical disk image not found at database path: $IMAGE_PATH"
      fi
      log_info "Using image_path from database: $IMAGE_PATH"
    else
      # Fall back to searching for .raw files (legacy behavior)
      SEARCH_PATHS=("$IMAGE_ROOT" "/data/cold/img-unprocessed")
      SOURCE_DIR=""

      for search_path in "${SEARCH_PATHS[@]}"; do
        if [[ -f "$search_path/${MEDIUM_HASH}.raw" ]]; then
          SOURCE_DIR="$search_path"
          break
        fi
      done

      if [[ -z "$SOURCE_DIR" ]]; then
        fail "Physical disk image not found in: ${SEARCH_PATHS[*]} (pattern: ${MEDIUM_HASH}.raw or ${MEDIUM_HASH}.img)"
      fi
      log_info "Found physical disk image via search: $SOURCE_DIR/${MEDIUM_HASH}.raw"
    fi

    ARCHIVE_BASENAME="$MEDIUM_HASH"
    ARCHIVE_FILE="$ARCHIVE_ROOT/${MEDIUM_HASH}.1.dar"
    DAR_EXCLUDES=()
    ;;

  extracted)
    # Extracted directory - use image_path from database or --source override
    if [[ -n "$SOURCE_OVERRIDE" ]]; then
      SOURCE_DIR="$SOURCE_OVERRIDE"
    elif [[ -n "$IMAGE_PATH" ]]; then
      SOURCE_DIR="$IMAGE_PATH"
    else
      fail "No source directory for extracted medium (use --source or check database)"
    fi

    if [[ ! -d "$SOURCE_DIR" ]]; then
      fail "Extracted directory not found: $SOURCE_DIR"
    fi

    log_info "Found extracted directory: $SOURCE_DIR"
    ARCHIVE_BASENAME="$MEDIUM_HASH"
    ARCHIVE_FILE="$ARCHIVE_ROOT/${MEDIUM_HASH}.1.dar"

    # Exclude the extracted/ subdirectory if it exists
    if [[ -d "$SOURCE_DIR/extracted" ]]; then
      DAR_EXCLUDES=("-P" "extracted")
      log_info "Will exclude extracted/ subdirectory from archive"
    else
      DAR_EXCLUDES=()
    fi
    ;;

  floppy)
    # Floppy directory
    SOURCE_DIR="/data/fast/floppies/disks/${MEDIUM_HASH}"

    if [[ ! -d "$SOURCE_DIR" ]]; then
      fail "Floppy directory not found: $SOURCE_DIR"
    fi

    log_info "Found floppy directory: $SOURCE_DIR"
    mkdir -p "$ARCHIVE_ROOT/floppies"
    ARCHIVE_BASENAME="floppies/$MEDIUM_HASH"
    ARCHIVE_FILE="$ARCHIVE_ROOT/floppies/${MEDIUM_HASH}.1.dar"
    DAR_EXCLUDES=()
    ;;

  manual)
    # Manual source override
    if [[ -z "$SOURCE_OVERRIDE" ]]; then
      fail "Manual mode requires --source directory"
    fi

    SOURCE_DIR="$SOURCE_OVERRIDE"

    if [[ ! -d "$SOURCE_DIR" ]] && [[ ! -f "$SOURCE_DIR" ]]; then
      fail "Manual source not found: $SOURCE_DIR"
    fi

    log_info "Using manual source: $SOURCE_DIR"
    ARCHIVE_BASENAME="$MEDIUM_HASH"
    ARCHIVE_FILE="$ARCHIVE_ROOT/${MEDIUM_HASH}.1.dar"
    DAR_EXCLUDES=()
    ;;

  *)
    fail "Unknown medium_type: $MEDIUM_TYPE"
    ;;
esac

# Check if archive already exists
if [[ -f "$ARCHIVE_FILE" ]]; then
  if [[ "$FORCE" == "true" ]]; then
    log_warn "Archive already exists, overwriting (--force): $ARCHIVE_FILE"
  else
    log_info "Archive already exists (skipping): $ARCHIVE_FILE"
    exit 2
  fi
fi

# Safety check: Verify all paths are copied (unless --force)
# Skip verification for floppy (no database tracking) and manual (may not be in DB)
if [[ "$FORCE" == "false" ]] && [[ "$MEDIUM_TYPE" != "floppy" ]] && [[ "$MEDIUM_TYPE" != "manual" ]]; then
  log_info "Checking copy completion..."

  COPY_STATUS=$(psql_as_user "$DB_URL" -tAc "
    SELECT
      COUNT(*) FILTER (WHERE copied = true) as copied,
      COUNT(*) FILTER (WHERE copied = false) as pending,
      COUNT(*) as total
    FROM paths
    WHERE medium_hash = '$MEDIUM_HASH'
  " 2>/dev/null | grep -v "^Pager" | grep "|")

  COPIED=$(echo "$COPY_STATUS" | cut -d'|' -f1)
  PENDING=$(echo "$COPY_STATUS" | cut -d'|' -f2)
  TOTAL=$(echo "$COPY_STATUS" | cut -d'|' -f3)

  if [[ $TOTAL -eq 0 ]]; then
    log_warn "No paths found for this medium (empty filesystem?)"
  elif [[ $PENDING -gt 0 ]]; then
    fail "Copy incomplete: $PENDING of $TOTAL paths not copied (use --force to skip)"
  else
    log_info "Copy complete: $COPIED of $TOTAL paths copied"
  fi
else
  log_info "Skipping copy verification (medium_type=$MEDIUM_TYPE, force=$FORCE)"
fi

# Generate metadata.json if it doesn't exist (for extracted/floppy types)
if [[ "$MEDIUM_TYPE" == "extracted" ]] || [[ "$MEDIUM_TYPE" == "floppy" ]]; then
  METADATA_FILE="$SOURCE_DIR/metadata.json"

  if [[ ! -f "$METADATA_FILE" ]]; then
    log_info "Generating metadata.json: $METADATA_FILE"

    # Query medium table for metadata
    MEDIUM_DATA=$(psql_as_user "$DB_URL" -tAc "
      SELECT medium_hash, medium_human, added_at, enum_done, copy_done,
             health, image_path, message, diagnostics, problems,
             medium_type, source_blobid, extraction_method, extracted_at
      FROM medium
      WHERE medium_hash = '$MEDIUM_HASH'
    " 2>/dev/null | grep -v "^Pager")

    if [[ -n "$MEDIUM_DATA" ]]; then
      # Parse the pipe-delimited row
      IFS='|' read -r m_hash m_human m_added m_enum m_copy m_health m_image \
                      m_message m_diag m_problems m_type m_blob m_extract m_extracted_at <<< "$MEDIUM_DATA"

      # Generate JSON (basic formatting)
      cat > "$METADATA_FILE" <<EOF
{
  "medium_hash": "$m_hash",
  "medium_human": "$m_human",
  "added_at": "$m_added",
  "enum_done": "$m_enum",
  "copy_done": "$m_copy",
  "health": $([[ -z "$m_health" ]] && echo "null" || echo "\"$m_health\""),
  "image_path": "$m_image",
  "message": $([[ -z "$m_message" ]] && echo "null" || echo "\"$m_message\""),
  "diagnostics": $([[ -z "$m_diag" ]] && echo "null" || echo "\"$m_diag\""),
  "problems": $([[ -z "$m_problems" ]] && echo "null" || echo "\"$m_problems\""),
  "medium_type": "$m_type",
  "source_blobid": $([[ -z "$m_blob" ]] && echo "null" || echo "\"$m_blob\""),
  "extraction_method": $([[ -z "$m_extract" ]] && echo "null" || echo "\"$m_extract\""),
  "extracted_at": $([[ -z "$m_extracted_at" ]] && echo "null" || echo "\"$m_extracted_at\"")
}
EOF
      log_info "Created metadata.json from database"
    else
      log_warn "No database entry found for $MEDIUM_HASH, creating minimal metadata.json"
      cat > "$METADATA_FILE" <<EOF
{
  "medium_hash": "$MEDIUM_HASH",
  "medium_human": null,
  "added_at": null,
  "enum_done": null,
  "copy_done": null,
  "health": null,
  "image_path": "$SOURCE_DIR",
  "message": null,
  "diagnostics": null,
  "problems": null,
  "medium_type": "$MEDIUM_TYPE",
  "source_blobid": null,
  "extraction_method": null,
  "extracted_at": null
}
EOF
    fi
  else
    log_info "metadata.json already exists: $METADATA_FILE"
  fi
fi

# Create archive with dar
log_info "Creating archive: $ARCHIVE_FILE"

# Build dar command
if [[ "$MEDIUM_TYPE" == "physical" ]] && [[ -n "$IMAGE_PATH" ]]; then
  # For physical disks with explicit image_path, archive specific files by explicit list
  # Build list of files to archive (avoiding dar -g glob which can exclude everything)

  # Save current directory
  ORIG_DIR=$(pwd)
  cd "$SOURCE_DIR" || fail "Cannot cd to $SOURCE_DIR"

  FILES_TO_ARCHIVE=()
  # Check for all possible file extensions for this medium_hash
  for pattern in "${MEDIUM_HASH}.img" "${MEDIUM_HASH}.raw" "${MEDIUM_HASH}.map" \
                 "${MEDIUM_HASH}.json" "${MEDIUM_HASH}-ddrescue.log" \
                 "${MEDIUM_HASH}.map.bak" "${MEDIUM_HASH}.map.stall"; do
    if [[ -f "$pattern" ]]; then
      FILES_TO_ARCHIVE+=("$pattern")
    fi
  done

  if [[ ${#FILES_TO_ARCHIVE[@]} -eq 0 ]]; then
    cd "$ORIG_DIR"
    fail "No files found matching pattern ${MEDIUM_HASH}* in $SOURCE_DIR"
  fi

  log_info "Archiving ${#FILES_TO_ARCHIVE[@]} file(s): ${FILES_TO_ARCHIVE[*]}"

  # Use explicit file list - dar will archive these from current directory
  DAR_CMD=(dar -c "$ARCHIVE_ROOT/$ARCHIVE_BASENAME" "${FILES_TO_ARCHIVE[@]}")
else
  # For directories (extracted, floppy) or legacy physical, archive entire directory
  DAR_CMD=(dar -c "$ARCHIVE_ROOT/$ARCHIVE_BASENAME" -R "$SOURCE_DIR")
fi

# Add excludes if any
if [[ ${#DAR_EXCLUDES[@]} -gt 0 ]]; then
  DAR_CMD+=("${DAR_EXCLUDES[@]}")
fi

# Add compression and no-slicing
DAR_CMD+=(-zzstd:3 -s 0)

# Add verbosity if requested
if [[ "$VERBOSE" == "true" ]]; then
  DAR_CMD+=(-v)
fi

# Execute dar
log_info "Running: ${DAR_CMD[*]}"
if "${DAR_CMD[@]}"; then
  log_info "Archive created successfully"
else
  DAR_EXIT=$?
  # Restore directory if we changed it
  if [[ "$MEDIUM_TYPE" == "physical" ]] && [[ -n "$IMAGE_PATH" ]] && [[ -n "$ORIG_DIR" ]]; then
    cd "$ORIG_DIR"
  fi
  fail "Archive creation failed (dar exit code: $DAR_EXIT)"
fi

# Restore original directory if we changed it
if [[ "$MEDIUM_TYPE" == "physical" ]] && [[ -n "$IMAGE_PATH" ]] && [[ -n "$ORIG_DIR" ]]; then
  cd "$ORIG_DIR"
  log_info "Restored working directory"
fi

# Chown archive to pball:pball with 644
if [[ -n "$SUDO_USER" ]]; then
  chown "$SUDO_USER:$SUDO_USER" "$ARCHIVE_FILE"
  chmod 644 "$ARCHIVE_FILE"
  log_info "Archive ownership: $SUDO_USER:$SUDO_USER 644"
fi

# Verify archive exists and has size > 0
if [[ ! -f "$ARCHIVE_FILE" ]]; then
  fail "Archive verification failed: file not found after creation"
fi

ARCHIVE_SIZE=$(stat -c%s "$ARCHIVE_FILE")
if [[ $ARCHIVE_SIZE -eq 0 ]]; then
  fail "Archive verification failed: file size is 0"
fi

ARCHIVE_SIZE_HUMAN=$(stat -c%s "$ARCHIVE_FILE" | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${ARCHIVE_SIZE} bytes")
log_info "Archive created: $ARCHIVE_SIZE_HUMAN"

# CRITICAL: Verify archive actually contains files before deletion
log_info "Verifying archive contents..."

# Count files in archive (lines starting with [ in dar -l output)
ARCHIVED_COUNT=$(dar -l "$ARCHIVE_FILE" 2>&1 | grep -c "^\[" || echo "0")

if [[ $ARCHIVED_COUNT -eq 0 ]]; then
  fail "Archive verification FAILED: 0 files archived (dar may have excluded everything). Refusing to delete source files. Archive: $ARCHIVE_FILE"
fi

log_info "Archive contains $ARCHIVED_COUNT file(s)"

# For physical disks, verify critical files are present
if [[ "$MEDIUM_TYPE" == "physical" ]]; then
  # Check for .img or .raw file in archive
  if ! dar -l "$ARCHIVE_FILE" 2>&1 | grep -q -E "${MEDIUM_HASH}\.(img|raw)"; then
    fail "Archive verification FAILED: disk image file (.img or .raw) not found in archive. Refusing to delete source files."
  fi
  log_info "Verified: disk image file present in archive"
fi

# Minimum size check: archive should be at least some reasonable fraction of source
# (accounting for compression, but catching completely empty archives)
if [[ "$MEDIUM_TYPE" == "physical" ]]; then
  # Calculate total size of source files
  SOURCE_SIZE=$(find "$SOURCE_DIR" -name "${MEDIUM_HASH}*" -type f -exec stat -c%s {} + 2>/dev/null | awk '{sum+=$1} END {print sum}')
  if [[ -z "$SOURCE_SIZE" ]] || [[ $SOURCE_SIZE -eq 0 ]]; then
    log_warn "Could not calculate source size, skipping size verification"
  else
    # Archive should be at least 5% of source (very conservative for compression)
    MIN_SIZE=$((SOURCE_SIZE / 20))
    if [[ $ARCHIVE_SIZE -lt $MIN_SIZE ]]; then
      SOURCE_SIZE_HUMAN=$(echo "$SOURCE_SIZE" | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${SOURCE_SIZE} bytes")
      MIN_SIZE_HUMAN=$(echo "$MIN_SIZE" | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${MIN_SIZE} bytes")
      fail "Archive verification FAILED: archive too small (${ARCHIVE_SIZE_HUMAN} < ${MIN_SIZE_HUMAN}, source=${SOURCE_SIZE_HUMAN}). Refusing to delete source files."
    fi
    log_info "Size check passed: archive size reasonable compared to source"
  fi
fi

log_info "✓ Archive verification passed: $ARCHIVED_COUNT files, size checks OK"

# Remove source files/directories
case "$MEDIUM_TYPE" in
  physical)
    # Physical disk image - remove .raw file and related files
    log_info "Removing source files: $SOURCE_DIR/${MEDIUM_HASH}*"

    rm -f "$SOURCE_DIR/${MEDIUM_HASH}"*

    # Verify all matching files are gone
    REMAINING_FILES=("$SOURCE_DIR/${MEDIUM_HASH}"*)
    if [[ -e "${REMAINING_FILES[0]}" ]]; then
      log_warn "Some source files still exist:"
      for f in "${REMAINING_FILES[@]}"; do
        ls -lh "$f" >&2
      done
      fail "Source file removal verification failed"
    fi

    log_info "Source files removed successfully"
    ;;

  extracted|floppy)
    # Directory-based sources - remove entire directory
    log_info "Removing source directory: $SOURCE_DIR"

    rm -rf "$SOURCE_DIR"

    # Verify directory is gone
    if [[ -d "$SOURCE_DIR" ]]; then
      fail "Directory removal failed: $SOURCE_DIR still exists"
    fi

    log_info "Source directory removed successfully"
    ;;

  manual)
    # Manual mode - log but don't remove (user should manage manually)
    log_info "Manual source - NOT removing: $SOURCE_DIR (manage manually)"
    ;;

  *)
    log_warn "Unknown medium_type for removal: $MEDIUM_TYPE"
    ;;
esac

# Success
log_info "Archive complete: $ARCHIVE_FILE ($ARCHIVE_SIZE_HUMAN)"

exit 0
