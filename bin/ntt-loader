#!/usr/bin/env bash
# Author: PB and Claude
# Date: 2025-11-16
# License: (c) HRDAG, 2025, GPL-2 or newer
#
# ------
# ntt/bin/ntt-loader
#
# NTT loader (unpartitioned) – streaming .raw (034/NUL) → single paths table
#
# Key differences from ntt-loader-partitioned:
#   - No partition creation or management
#   - DELETE-based reload instead of TRUNCATE
#   - Single denormalized INSERT into paths table
#   - Performance logging for DELETE operations
#
# Expected performance: TBD (testing needed)
#
# bash-logger: INTEGRATED (2025-11-16)

set -euo pipefail

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

FILE=${1:?file.raw required}
MEDIUM_HASH=${2:?medium_hash required}
DB_URL=${NTT_DB_URL:-postgres:///copyjob}
LOG_FILE=${NTT_LOADER_LOG:-/var/log/ntt/loader.jsonl}
ENUM_LOG=${NTT_ENUM_LOG:-/var/log/ntt/enum.jsonl}

# Initialize logging
# shellcheck source=../lib/bash-logger.sh
source "$LIB_DIR/bash-logger.sh"
log_init || exit 1

mkdir -p "$(dirname "$LOG_FILE")"
chmod 755 "$(dirname "$LOG_FILE")" 2>/dev/null || true

# Validate ignore patterns file exists
IGNORE_PATTERNS="${NTT_IGNORE_PATTERNS:-/home/pball/.config/ntt/ignore-patterns.txt}"
if [[ ! -f "$IGNORE_PATTERNS" ]]; then
  echo "Error: Ignore patterns file not found: $IGNORE_PATTERNS" >&2
  echo "Set NTT_IGNORE_PATTERNS environment variable or create default file" >&2
  exit 1
fi

# ---------- logging functions ----------
fail() {
  log_error "$1"
  exit 1
}

# ---------- 1. create working table ----------
TABLE_NAME="tmp_path_$$"
log_info "Creating working table" file="$FILE" medium_hash="$MEDIUM_HASH"

# Create temp table that matches raw file format
TEMP_TABLE="raw_$$"
sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -c "
CREATE TABLE $TEMP_TABLE (
  fs_type     char(1),
  dev         bigint,
  ino         bigint,
  nlink       int,
  size        bigint,
  mtime       bigint,
  path        text
);

CREATE TABLE $TABLE_NAME (
  medium_hash text,
  fs_type     char(1),
  dev         bigint,
  ino         bigint,
  nlink       int,
  size        bigint,
  mtime       numeric,
  path        text,
  exclude_reason text
);
" || fail "Failed to create working tables"

# ---------- 2. raw → working table (034 delimiter) ----------
log_info "Loading raw data into working table" file="$FILE"

# Get expected record count from enum log instead of re-counting
EXPECTED_RECORDS=$(jq -rs --arg file "$FILE" '
  map(select(.stage == "enum_complete" and .out == $file)) |
  sort_by(.ts) | last | .rows // "unknown"
' "$ENUM_LOG")
log_info "Expecting records from enum log" expected_records="$EXPECTED_RECORDS"

# Escape literal CR/LF in data, then convert null to LF for PostgreSQL
log_info "Starting PostgreSQL COPY command"

# Use temporary file to capture both output and exit code
TEMP_OUTPUT="/tmp/ntt-copy-output-$$"
# Pipeline: field-aware escaping (delimiter 034 only in path field) → PostgreSQL COPY
# ntt-escape-raw.pl: escapes backslash, delimiter, CR, LF in 7th field (path) only
# NOTE: Paths are stored as bytea to preserve invalid UTF-8 sequences
# Use Latin1 encoding to accept all byte values without UTF-8 validation
NTT_BIN="${NTT_BIN:-$(dirname "$0")}"
if "$NTT_BIN/ntt-escape-raw.pl" < "$FILE" | \
    sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -c "
SET client_encoding = 'LATIN1';

COPY $TEMP_TABLE(fs_type,dev,ino,nlink,size,mtime,path)
FROM STDIN
WITH (FORMAT text, DELIMITER E'\\034', NULL '');
" > "$TEMP_OUTPUT" 2>&1; then
  log_info "PostgreSQL COPY command completed"
  COPY_RESULT=$(cat "$TEMP_OUTPUT")
else
  log_error "PostgreSQL COPY command failed"
  cat "$TEMP_OUTPUT" >&2
  rm -f "$TEMP_OUTPUT"
  fail "Failed to load raw data into temp table"
fi
rm -f "$TEMP_OUTPUT"

# Extract actual imported count from PostgreSQL output
ACTUAL_RECORDS=$(echo "$COPY_RESULT" | grep "COPY" | grep -o '[0-9]*' | tail -1)
log_info "PostgreSQL imported records" actual_records="$ACTUAL_RECORDS"

# Sanity check: compare expected vs actual
if [[ "$EXPECTED_RECORDS" != "unknown" ]] && [[ "$EXPECTED_RECORDS" != "$ACTUAL_RECORDS" ]]; then
  log_warn "Record count mismatch" expected="$EXPECTED_RECORDS" actual="$ACTUAL_RECORDS"
fi

# Transfer data to working table with medium_hash
# Note: path is kept as text in temp tables, will be converted to bytea when inserting to final path table
sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -c "
INSERT INTO $TABLE_NAME (medium_hash,fs_type,dev,ino,nlink,size,mtime,path)
SELECT '$MEDIUM_HASH', fs_type, dev, ino, nlink, size, mtime, path
FROM $TEMP_TABLE;
" || fail "Failed to transfer data to working table"

# ---------- 2.5 mark excluded paths ----------
log_info "Marking excluded paths"

# Load patterns from file, skip comments and empty lines, combine with | for regex alternation
PATTERNS=$(grep -v '^#' "$IGNORE_PATTERNS" | grep -v '^$' | paste -sd '|' -)

# Add shell-unsafe characters to exclude list
PATTERNS="${PATTERNS}|#"

PATTERN_COUNT=$(grep -cv '^#\|^$' "$IGNORE_PATTERNS")
log_info "Applying exclusion patterns" pattern_count="$PATTERN_COUNT"

# Mark paths matching patterns (path is text in working table, no conversion needed)
EXCLUDED_COUNT=$(sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -t -A -c "
  UPDATE $TABLE_NAME
  SET exclude_reason = 'pattern_match'
  WHERE path ~ '$PATTERNS';
  SELECT COUNT(*) FROM $TABLE_NAME WHERE exclude_reason = 'pattern_match';
" | tail -1)

log_info "Marked paths as excluded" excluded_count="$EXCLUDED_COUNT" medium_hash="$MEDIUM_HASH"

# Create indexes on working table for fast deduplication operations
log_info "Creating indexes on working table"
sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -c "
CREATE INDEX idx_${TABLE_NAME}_ino ON $TABLE_NAME(ino);
CREATE INDEX idx_${TABLE_NAME}_ino_path ON $TABLE_NAME(ino, path);
" || fail "Failed to create indexes on working table"

# ---------- 3. load into paths table ----------
log_info "Loading into paths table" medium_hash="$MEDIUM_HASH"

# Capture start time for performance monitoring
LOAD_START=$(date +%s)

sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -c "
-- Performance tuning for bulk load
SET work_mem = '256MB';
SET maintenance_work_mem = '1GB';
SET synchronous_commit = OFF;
SET statement_timeout = '30min';  -- Increased for large DELETEs

-- medium row (if new) - use known medium_hash instead of scanning table
INSERT INTO medium (medium_hash, added_at)
VALUES ('$MEDIUM_HASH', now())
ON CONFLICT (medium_hash) DO NOTHING;

-- DELETE existing data for this medium (idempotent reload)
-- This replaces the old TRUNCATE partition approach
DO \$\$
DECLARE
  delete_start_time timestamptz := clock_timestamp();
  deleted_count bigint;
  delete_duration_ms numeric;
BEGIN
  DELETE FROM paths WHERE medium_hash = '$MEDIUM_HASH';
  GET DIAGNOSTICS deleted_count = ROW_COUNT;
  delete_duration_ms := extract(epoch from clock_timestamp() - delete_start_time) * 1000;

  -- Log DELETE performance for monitoring
  RAISE NOTICE 'DELETE performance: % rows in %.2f ms (%.2f ms/1000 rows)',
    deleted_count,
    delete_duration_ms,
    CASE WHEN deleted_count > 0 THEN delete_duration_ms / (deleted_count / 1000.0) ELSE 0 END;
END\$\$;

-- Insert all paths with inode metadata
-- Note: No deduplication - all paths inserted (including hardlinks)
INSERT INTO paths (
  medium_hash, path, dev, ino, size, mtime, fs_type, nlink,
  exclude_reason, copied
)
SELECT
  '$MEDIUM_HASH',
  convert_to(path, 'LATIN1'),  -- Convert to bytea to preserve exact bytes
  dev, ino, size, mtime, fs_type, nlink,
  exclude_reason,
  -- Mark non-files and excluded files as already copied
  CASE WHEN fs_type = 'f' AND exclude_reason IS NULL THEN false ELSE true END
FROM $TABLE_NAME;

-- Update queue_stats for this medium
-- Copier workers check queue_stats to determine claiming strategy
INSERT INTO queue_stats (medium_hash, unclaimed_count, total_count)
SELECT
  '$MEDIUM_HASH',
  COUNT(*) FILTER (WHERE copied = false),
  COUNT(*)
FROM paths
WHERE medium_hash = '$MEDIUM_HASH'
ON CONFLICT (medium_hash) DO UPDATE
SET unclaimed_count = EXCLUDED.unclaimed_count,
    total_count = EXCLUDED.total_count,
    last_updated = NOW();

-- Optional: ANALYZE paths for query planner
-- Only needed if table statistics are stale
-- ANALYZE paths;
" || fail "Failed to load into paths table"

# Log load performance
LOAD_END=$(date +%s)
LOAD_DURATION=$((LOAD_END - LOAD_START))
log_info "Load completed" duration_sec="$LOAD_DURATION" medium_hash="$MEDIUM_HASH"

# Count excluded paths (those with exclude_reason set)
EXCLUDED_PATHS=$(sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -t -A -c "
  SELECT COUNT(*)
  FROM paths
  WHERE medium_hash = '$MEDIUM_HASH'
    AND exclude_reason IS NOT NULL
" 2>/dev/null | grep -o '[0-9]*' | head -1 || echo "0")

log_info "Marked paths as EXCLUDED" count="$EXCLUDED_PATHS" medium_hash="$MEDIUM_HASH"

# Count non-file paths (directories, symlinks, special files) - those copied=true but no exclude_reason
NON_FILE_PATHS=$(sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -t -A -c "
  SELECT COUNT(*)
  FROM paths
  WHERE medium_hash = '$MEDIUM_HASH'
    AND copied = true
    AND exclude_reason IS NULL
" 2>/dev/null | grep -o '[0-9]*' | head -1 || echo "0")

log_info "Marked paths as NON_FILE" count="$NON_FILE_PATHS" medium_hash="$MEDIUM_HASH"

# ---------- 4. cleanup and summary ----------
ROWS=$(sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -t -A -c "SELECT count(*) FROM paths WHERE medium_hash='$MEDIUM_HASH'" 2>/dev/null | grep -o '[0-9]*' | head -1 || echo "unknown")

# Drop the working tables
sudo -u "${SUDO_USER:-$USER}" psql "$DB_URL" -c "DROP TABLE $TABLE_NAME, $TEMP_TABLE;" 2>/dev/null || true

if [[ "$ACTUAL_RECORDS" == "0" ]]; then
  log_info "Loading complete (no new records)" rows="$ROWS" medium_hash="$MEDIUM_HASH"
else
  log_info "Loading complete" rows="$ROWS" medium_hash="$MEDIUM_HASH"
fi

exit 0
